# ───────────── INPUT NEEDED: copy to .env.local (local) and to Vercel → Settings → Environment Variables ─────────────

NEXT_PUBLIC_SITE_URL=https://methodflow.geodesia.online

NEXT_PUBLIC_GSC_TOKEN=

# DeepSeek. Key from platform.deepseek.com. Check names with: GET https://api.deepseek.com/models
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_DEEP_MODEL=deepseek-v4-pro
DEEPSEEK_DEEP_EFFORT=high
DEEPSEEK_DEEP_MAX_TOKENS=16000

# Fallback provider (optional)
OPENAI_API_KEY=
OPENAI_MODEL=

# Cost guard, USD per 1M tokens. Set to PEAK-hour rates from platform.deepseek.com/pricing so the guard over-counts, not under-counts.
PRICE_IN_PER_M=0.30
PRICE_OUT_PER_M=1.20
PRICE_IN_PER_M_DEEP=1.32
PRICE_OUT_PER_M_DEEP=3.96
PRICE_IN_PER_M_OPENAI=
PRICE_OUT_PER_M_OPENAI=
DAILY_BUDGET_USD=5

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase. SUPABASE_URL is the server-side URL for share links; the NEXT_PUBLIC pair is for auth and cloud save.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Billing and mail
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_MONTHLY=
LEMONSQUEEZY_VARIANT_HALF_YEARLY=
LEMONSQUEEZY_VARIANT_YEARLY=
RESEND_API_KEY=
