# ───────────── INPUT NEEDED: copy to .env.local (local) and to Vercel → Settings → Environment Variables ─────────────

# Public site URL (used for canonical URLs, sitemap, share links)
NEXT_PUBLIC_SITE_URL=https://flowchart.geodesia.online

# Google Search Console HTML-tag verification token (the content="..." value only). Optional.
NEXT_PUBLIC_GSC_TOKEN=

# AI provider 1 — DeepSeek. Get a key at platform.deepseek.com
DEEPSEEK_API_KEY=
# INPUT NEEDED: exact model id from DeepSeek's current docs (I did not hardcode one on purpose)
DEEPSEEK_MODEL=

# AI provider 2 (fallback, optional). Leave blank to run on DeepSeek only.
OPENAI_API_KEY=
OPENAI_MODEL=

# Cost guard. Prices are USD per 1M tokens — copy from your provider's pricing page.
PRICE_IN_PER_M=0.30
PRICE_OUT_PER_M=1.20
DAILY_BUDGET_USD=5

# Upstash Redis (rate limits + budget counter). Free tier is enough. Without it, in-memory limits are used (weaker on serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase (share links only). Server-side only: never prefix with NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
